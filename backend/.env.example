# ── Application ──────────────────────────────────────────
APP_NAME=warehouse-api
DEBUG=true
LOGGING_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── PostgreSQL ──────────────────────────────────────────
# Значения ниже — для запуска backend напрямую (venv) при поднятых
# через `docker compose up -d postgres redis` контейнерах (см. корневой docker-compose.yml).
# При запуске backend как контейнера (docker compose up) их переопределяют
# environment-значения из docker-compose.yml (postgres:5432 вместо localhost:5433).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mydb
DATABASE_URL_SQLALCHEMY=postgresql+asyncpg://postgres:postgres@localhost:5433/mydb
DB_SCHEMA=public
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=20

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Auth ────────────────────────────────────────────
# RS256-ключи генерируются автоматически при первом запуске в Docker (entrypoint.sh).
# Для локального запуска через venv — сгенерировать вручную:
# openssl genrsa -out keys/private.pem 2048 && openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_LIFETIME=3600
REFRESH_TOKEN_LIFETIME=604800

# ── Уведомления о заказах (bot-сервис) ────────────────────
BOT_SERVICE_URL=http://localhost:8100
# Должен совпадать с INTERNAL_API_TOKEN в bot/.env.
INTERNAL_API_TOKEN=change-me
