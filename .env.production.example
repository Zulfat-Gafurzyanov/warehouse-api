# Копировать в .env на боевом сервере (рядом с docker-compose.yml), заполнить и сохранить.
# Этот файл — только пример, сам .env в git не попадает.

# Домен без схемы и без www — например, mydomain.ru
DOMAIN=

# Почта для Let's Encrypt — на неё придёт уведомление, если сертификат
# вдруг не продлится (не должно случиться — продление в cron, но на всякий).
CERTBOT_EMAIL=
