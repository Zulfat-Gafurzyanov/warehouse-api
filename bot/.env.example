# Токен бота, полученный у @BotFather в Telegram.
TELEGRAM_BOT_TOKEN=
# chat_id администратора (или группы), которому будут приходить уведомления о заказах.
TELEGRAM_ADMIN_CHAT_ID=
# Ссылка "Открыть заказ в CRM" в уведомлении — необязательно.
ADMIN_PANEL_URL=
# Должен совпадать с INTERNAL_API_TOKEN в backend/.env.
INTERNAL_API_TOKEN=change-me
PORT=8100
